PORT=3010
PUBLIC_URL=http://localhost:3010
# Demo identities and host controls are allowed only when DEMO_MODE=true.
DEMO_MODE=true
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_ID=
# A user access token with user:read:chat for this broadcaster account.
TWITCH_CHAT_TOKEN=
# Saved by local chat reconnect; enables automatic access-token rotation.
TWITCH_CHAT_REFRESH_TOKEN=
# Optional host console protection in demo mode; mandatory outside demo.
HOST_KEY=
# Optional: use an API key for real Codex goal decisions. Without one, the pet
# follows locally and the interface clearly labels the fallback.
CODEX_PET_API_KEY=
